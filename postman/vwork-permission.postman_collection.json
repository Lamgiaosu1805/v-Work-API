{
  "info": {
    "_postman_id": "b6f2a2b0-6e1a-4a3e-9c1a-vwork-permission",
    "name": "vWork - Permission Module (RBAC) + CRM ABAC",
    "description": "Test suite cho module phân quyền ABAC (src/modules/permission) và các route CRM đã chuyển sang requirePermission. Đăng nhập 1 lần ở folder Auth, các request khác tự dùng {{accessToken}} qua Bearer auth ở cấp collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:2345", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "employeeId", "value": "", "type": "string" },
    { "key": "dataScopePolicyId", "value": "", "type": "string" },
    { "key": "fieldScopePolicyId", "value": "", "type": "string" },
    { "key": "permissionCode", "value": "employee.view", "type": "string" },
    { "key": "entity", "value": "Employee", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "saleUserInfoId", "value": "", "type": "string" },
    { "key": "claimPeriodId", "value": "", "type": "string" },
    { "key": "customerClaimRequestId", "value": "", "type": "string" },
    { "key": "appCode", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Có accessToken\", () => pm.expect(json.accessToken).to.be.a(\"string\"));",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set(\"accessToken\", json.accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", json.refreshToken || \"\");",
                  "  console.log(\"Đã lưu accessToken vào collection variable\");",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
