                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Trả về id role mới\", () => pm.expect(json.data.id).to.be.a(\"string\"));",
                  "pm.test(\"Tên không vượt quá 100 ký tự (BR đã fix)\", () => pm.expect(json.data.name.length).to.be.at.most(100));",
